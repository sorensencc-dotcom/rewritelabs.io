{
  "name": "classify.request",
  "description": "Interpret user intent from a request string.",
  "input_schema": {
    "type": "object",
    "properties": {
      "request": { "type": "string" }
    },
    "required": ["request"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "intent": { "type": "string" },
      "recommended_tool": { "type": "string" }
    }
  }
}
