{
  "name": "sweeper.enumerate",
  "description": "Enumerate files for sweeper processing.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": { "type": "string" },
      "recursive": { "type": "boolean", "default": true }
    },
    "required": ["path"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "targets": { "type": "array", "items": { "type": "string" } }
    }
  }
}
