{
  "name": "docs.list",
  "description": "List documentation files.",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": { "type": "string" },
      "recursive": { "type": "boolean", "default": true }
    },
    "required": ["path"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "files": { "type": "array", "items": { "type": "string" } }
    }
  }
}
