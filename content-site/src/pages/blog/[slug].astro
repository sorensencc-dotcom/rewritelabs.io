---
import Base from '../../layouts/Base.astro';
import { asset } from '../../lib/assets';
import { publishedPosts, allBriefings, relatedBriefingsFor, formatDate, readingMinutes } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const related = relatedBriefingsFor(post, await allBriefings());
const minutes = readingMinutes(post.body);
const { title, description, date, topics, image, imageAlt, originalUrl, originalLabel } = post.data;
const url = new URL(`/blog/${post.slug}/`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  mainEntityOfPage: url,
  image: new URL(image ?? '/og.png', Astro.site).href,
  publisher: { '@type': 'Organization', name: 'Rewrite Labs', url: Astro.site?.href },
};
---

<Base title={`${title} — Rewrite Labs`} description={description} type="article" image={image}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article class="container article">
    <header class="article__head">
      <a href="/blog/" class="article__back">&larr; All posts</a>
      <p class="article__meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
      </p>
      <h1 class="article__title">{title}</h1>
      <p class="article__lede">{description}</p>
      {topics.length > 0 && (
        <ul class="chips" aria-label="Topics">
          {topics.map((t) => <li class="chip">{t}</li>)}
        </ul>
      )}
    </header>

    {image && (
      <figure class="article__figure">
        <img src={image} alt={imageAlt ?? ''} width="1376" height="768" decoding="async" />
      </figure>
    )}

    <div class="prose prose--article"><Content /></div>

    {originalUrl && (
      <p class="article__source">
        Originally shared on <a href={originalUrl} rel="noopener">{originalLabel ?? 'the original post'}</a>.
      </p>
    )}

    <aside class="article__cta" aria-labelledby="cta-title">
      <h2 id="cta-title" class="article__cta-title">Automation that runs on your own ground.</h2>
      <p>Rewrite Labs builds AI tools that keep your data and keys on your own machines. Early access is open.</p>
      <form class="signup" data-source={`blog:${post.slug}`} novalidate>
        <div class="signup__fields">
          <label class="sr-only" for="signup-email">Email address</label>
          <input id="signup-email" class="signup__input" name="email" type="email" autocomplete="email" placeholder="you@business.com" required />
          <button type="submit" class="btn-cta">Join waitlist &rarr;</button>
        </div>
        <p class="signup__note" role="status" aria-live="polite">We'll only use your email to contact you about early access. <a href="/privacy">Privacy</a></p>
      </form>
      <noscript><p class="signup__note">Turn on JavaScript to join here, or email <a href="mailto:info@rewritelabs.io">info@rewritelabs.io</a>.</p></noscript>
      <script is:inline src={asset('signup.js')} defer></script>
    </aside>

    {related.length > 0 && (
      <aside class="related">
        <h2 class="related__title">Related briefings</h2>
        <ul class="related__list">
          {related.map((b) => (
            <li><a href={`/ai-news-feed/${b.slug}/`}>{b.data.title}</a> <span class="feed__meta">{formatDate(b.data.date)}</span></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Base>
