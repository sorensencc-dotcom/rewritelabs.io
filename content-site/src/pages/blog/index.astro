---
import Base from '../../layouts/Base.astro';
import { publishedPosts, formatDate, readingMinutes } from '../../lib/content';
const posts = await publishedPosts();
const [latest, ...older] = posts;
---

<Base
  title="Blog | Rewrite Labs"
  description="Market research and notes from Rewrite Labs on AI, automation, and small-business websites."
  rss={{ href: '/blog/rss.xml', title: 'Rewrite Labs Blog' }}
>
  <div class="container blog">
    <header class="blog__head">
      <h1 class="display-lg blog__title">Market research and field notes.</h1>
      <p class="lede blog__lede">What we are learning about AI, automation, and the websites small businesses depend on.</p>
    </header>

    {!latest ? (
      <p class="feed__empty">First posts coming soon.</p>
    ) : (
      <>
        <article class="blog-feature">
          <p class="blog-feature__meta">
            <span class="blog-feature__label">Latest</span>
            <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
            <span>{readingMinutes(latest.body)} min read</span>
          </p>
          <h2 class="blog-feature__title"><a href={`/blog/${latest.id}/`} class="blog-feature__link">{latest.data.title}</a></h2>
          <p class="blog-feature__summary">{latest.data.description}</p>
          <div class="blog-feature__foot">
            {latest.data.topics.length > 0 && (
              <ul class="chips" aria-label="Topics">
                {latest.data.topics.map((t) => <li class="chip">{t}</li>)}
              </ul>
            )}
            <span class="blog-feature__more" aria-hidden="true">Read the post</span>
          </div>
        </article>

        {older.length > 0 && (
          <ol class="blog-list" aria-label="Earlier posts">
            {older.map((p) => (
              <li class="blog-row">
                <time class="blog-row__date" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                <div>
                  <h2 class="blog-row__title"><a href={`/blog/${p.id}/`} class="blog-row__link">{p.data.title}</a></h2>
                  <p class="blog-row__summary">{p.data.description}</p>
                </div>
              </li>
            ))}
          </ol>
        )}
      </>
    )}

    <p class="blog__more">
      Daily signals: <a href="/ai-news-feed/">AI News Feed</a>. Subscribe: <a href="/blog/rss.xml">RSS</a>.
    </p>
  </div>
</Base>
