---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allBriefings, publishedPosts, relatedPostsFor, formatDate, deltaGlyph } from '../../lib/content';

export async function getStaticPaths() {
  const briefings = await allBriefings();
  return briefings.map((briefing) => ({ params: { slug: briefing.id }, props: { briefing } }));
}

const { briefing } = Astro.props;
const { Content } = await render(briefing);
const related = relatedPostsFor(briefing, await publishedPosts());
const d = briefing.data;
---

<Base
  title={`${d.title} — Rewrite Labs`}
  description={d.summary ?? 'Daily AI briefing from Rewrite Labs.'}
  rss={{ href: '/ai-news-feed/rss.xml', title: 'Rewrite Labs AI News Feed' }}
>
  <article class="container post">
    <a href="/ai-news-feed/" class="post__back">&larr; AI News Feed</a>
    <div class="feed__row">
      <time class="feed__meta" datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      <span class="feed__meta">{Math.round(d.confidenceScore * 100)}% confidence &middot; {d.sourcesEvaluated} sources</span>
    </div>
    <h1 class="display-lg post__title">{d.title}</h1>
    {d.summary && <p class="lede">{d.summary}</p>}
    <div class="themes">
      {d.themes.map((t) => (
        <section class="theme">
          <h2 class="theme__name"><span class={`delta delta--${t.delta7d}`} aria-hidden="true">{deltaGlyph[t.delta7d]}</span> {t.name}</h2>
          <p class="feed__meta">{t.delta7d} over 7 days &middot; {t.tags.join(' · ')}</p>
          <p class="feed__summary">{t.summary}</p>
          <ul class="sources">
            {t.primarySources.map((s) => (
              <li><a href={s.url} rel="noopener noreferrer">{s.title}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <div class="prose"><Content /></div>
    {related.length > 0 && (
      <aside class="related">
        <h2 class="related__title">From the blog</h2>
        <ul class="related__list">
          {related.map((p) => (
            <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> <span class="feed__meta">{formatDate(p.data.date)}</span></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Base>
