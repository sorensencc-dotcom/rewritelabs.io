---
interface Props {
  title: string;
  description: string;
  rss?: { href: string; title: string };
  type?: 'website' | 'article';
  image?: string;
}
const { title, description, rss, type = 'website', image = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const ds = '/_ds/rewrite-labs-design-system-7b8b1b9a-3ab3-4fcb-883b-416a3c571ffe';
const tokens = ['colors', 'typography', 'spacing', 'radius', 'shadows', 'base'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rewrite Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0F0F1A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/fonts.css" />
    {tokens.map((t) => <link rel="stylesheet" href={`${ds}/tokens/${t}.css`} />)}
    <link rel="stylesheet" href={`${ds}/styles.css`} />
    <link rel="stylesheet" href="/site.css" />
    <slot name="head" />
    {rss && <link rel="alternate" type="application/rss+xml" title={rss.title} href={rss.href} />}
  </head>
  <body>
    <div class="nav">
      <a href="/" class="nav__brand">
        <div class="wordmark">Rewrite<span class="wordmark__slash">/</span><span class="wordmark__labs">Labs</span></div>
      </a>
      <div class="nav__actions">
        <a href="/blog/" class="nav__link">Blog</a>
        <a href="/ai-news-feed/" class="nav__link">AI News</a>
        <a href="/#waitlist" class="nav__cta">Early Access &rarr;</a>
      </div>
    </div>
    <main><slot /></main>
    <div class="footer">
      <div class="wordmark wordmark--sm">Rewrite<span class="wordmark__slash">/</span><span class="wordmark__labs">Labs</span></div>
      <div class="footer__legal">
        &copy; 2026 Cast Iron Productions LLC &middot; Rewrite Labs<br />
        7901 4th St N, Ste 300, St. Petersburg, FL 33702<br />
        <a href="/privacy" class="muted-link">Privacy</a> &middot; <a href="mailto:info@rewritelabs.io" class="muted-link">info@rewritelabs.io</a>
      </div>
    </div>
  </body>
</html>
