---
interface Props {
  title: string;
  description: string;
  rss?: { href: string; title: string };
  type?: 'website' | 'article';
  image?: string;
}
import { asset } from '../lib/assets';
const { title, description, rss, type = 'website', image = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rewrite Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0d1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <script is:inline>try{var t=localStorage.getItem("rl-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
    <script is:inline src={asset('theme.js')} defer></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/host-grotesk-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={asset('fonts.css')} />
    <link rel="stylesheet" href={asset('site.css')} />
    <slot name="head" />
    {rss && <link rel="alternate" type="application/rss+xml" title={rss.title} href={rss.href} />}
  </head>
  <body>
    <nav class="nav" aria-label="Primary">
      <a class="skip" href="#main">Skip to content</a>
      <div class="nav__bar">
        <div class="nav__links">
          <a href="/case-study" class="nav__link">Case study</a>
          <a href="/blog/" class="nav__link nav__link--wide">Blog</a>
          <a href="/ai-news-feed/" class="nav__link nav__link--wide">AI news</a>
        </div>
        <a href="/" class="nav__brand" aria-label="Rewrite Labs home">
          <span class="wordmark">
            <svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false"><rect class="mark__tile" x="1" y="1" width="30" height="30" rx="7"/><rect class="mark__old" x="7" y="9" width="13" height="3" rx="1.5"/><path class="mark__strike" d="M5.5 14.5L23 7.5"/><rect class="mark__new" x="7" y="18" width="18" height="4" rx="2"/></svg>
            <span class="wordmark__text">Rewrite <span class="wordmark__labs">Labs</span></span>
          </span>
        </a>
        <div class="nav__actions">
          <button type="button" class="theme-toggle" aria-label="Switch color theme">
            <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <a href="/#waitlist" class="btn btn--quiet">Get early access</a>
        </div>
      </div>
    </nav>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="container footer__grid">
        <div class="footer__id">
          <a href="/" class="footer__brand" aria-label="Rewrite Labs home">
            <span class="wordmark">
              <svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false"><rect class="mark__tile" x="1" y="1" width="30" height="30" rx="7"/><rect class="mark__old" x="7" y="9" width="13" height="3" rx="1.5"/><path class="mark__strike" d="M5.5 14.5L23 7.5"/><rect class="mark__new" x="7" y="18" width="18" height="4" rx="2"/></svg>
              <span class="wordmark__text">Rewrite <span class="wordmark__labs">Labs</span></span>
            </span>
          </a>
          <p class="footer__legal">&copy; 2026 Cast Iron Productions LLC (Rewrite Labs)<br />7901 4th St N, Ste 300<br />St. Petersburg, FL 33702</p>
        </div>
        <nav class="footer__col" aria-label="Read">
          <h2 class="footer__h">Read</h2>
          <ul>
            <li><a href="/blog/" class="link">Blog</a></li>
            <li><a href="/ai-news-feed/" class="link">AI News Feed</a></li>
            <li><a href="/case-study" class="link">Case study</a></li>
          </ul>
        </nav>
        <nav class="footer__col" aria-label="Company">
          <h2 class="footer__h">Company</h2>
          <ul>
            <li><a href="/privacy" class="link">Privacy</a></li>
            <li><a href="mailto:info@rewritelabs.io" class="link">info@rewritelabs.io</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
