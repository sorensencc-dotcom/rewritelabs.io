---
interface Props {
  title: string;
  description: string;
  rss?: { href: string; title: string };
  type?: 'website' | 'article';
  image?: string;
}
import { asset } from '../lib/assets';
const { title, description, rss, type = 'website', image = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const ds = '/_ds/rewrite-labs-design-system-7b8b1b9a-3ab3-4fcb-883b-416a3c571ffe';
const tokens = ['colors', 'typography', 'spacing', 'radius', 'shadows', 'base'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rewrite Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0F0F1A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F6FB" media="(prefers-color-scheme: light)" />
    <script is:inline>try{var t=localStorage.getItem("rl-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
    <script is:inline src={asset('theme.js')} defer></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={asset('fonts.css')} />
    {tokens.map((t) => <link rel="stylesheet" href={`${ds}/tokens/${t}.css`} />)}
    <link rel="stylesheet" href={`${ds}/styles.css`} />
    <link rel="stylesheet" href={asset('site.css')} />
    <slot name="head" />
    {rss && <link rel="alternate" type="application/rss+xml" title={rss.title} href={rss.href} />}
  </head>
  <body>
    <nav class="nav" aria-label="Primary">
      <a href="/" class="nav__brand">
        <div class="wordmark">Rewrite<span class="wordmark__slash">/</span><span class="wordmark__labs">Labs</span></div>
      </a>
      <div class="nav__actions">
        <a href="/blog/" class="nav__link">Blog</a>
        <a href="/ai-news-feed/" class="nav__link nav__link--wide">AI News</a>
        <button type="button" class="theme-toggle" aria-label="Switch color theme">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a href="/#waitlist" class="nav__cta">Early Access &rarr;</a>
      </div>
    </nav>
    <main><slot /></main>
    <footer class="footer">
      <div class="wordmark wordmark--sm">Rewrite<span class="wordmark__slash">/</span><span class="wordmark__labs">Labs</span></div>
      <div class="footer__legal">
        &copy; 2026 Cast Iron Productions LLC &middot; Rewrite Labs<br />
        7901 4th St N, Ste 300, St. Petersburg, FL 33702<br />
        <a href="/privacy" class="muted-link">Privacy</a> &middot; <a href="mailto:info@rewritelabs.io" class="muted-link">info@rewritelabs.io</a>
      </div>
    </footer>
  </body>
</html>
